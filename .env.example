# LLM Provider Configuration ('groq' or 'fireworks' or 'mock')
LLM_PROVIDER=groq

# Free Groq API Key (Get free key at: https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# AMD Instinct / Fireworks AI Configuration (For AMD hardware evaluation)
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_MODEL=accounts/fireworks/models/llama-v3p3-70b-instruct

# Local Directories
DATA_DIR=./data
CHROMA_PERSIST_DIR=./data/chroma_db

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173
DEBUG=True
